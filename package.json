{
  "name": "databricks-react-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": ["server", "client"],
  "scripts": {
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.3"
  }
}
